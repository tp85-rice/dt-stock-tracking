# Copy this file to .env (never commit .env) and fill in the values.
# The same names are used in GitHub secrets and Vercel settings.

# --- Database (worker, import script) ---------------------------------------
# Supabase > project dt-dashboard-prd > Connect > "Session pooler".
# Replace [YOUR-PASSWORD] with the database password.
DATABASE_URL=postgresql://postgres.loyiamqdycxljgcrmfbh:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres

# --- Supabase API (web app, from M2) ----------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://loyiamqdycxljgcrmfbh.supabase.co
# Supabase > Project Settings > API keys. The anon/publishable key is safe in
# the browser only because every table has row level security.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Full access, bypasses security rules. Worker and GitHub secrets ONLY, never Vercel.
SUPABASE_SERVICE_ROLE_KEY=

# --- Data sources (M4) -------------------------------------------------------
# SEC asks every client to identify itself with a contact.
SEC_USER_AGENT=dt-stock-tracking tp85@rice.edu
# Free key from https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# --- AI agents (M5) ----------------------------------------------------------
ANTHROPIC_API_KEY=
# Most the agents may spend per day (UTC), in US dollars. Calls that could go over it are refused.
AGENT_DAILY_USD_CAP=1.00

# --- Tests only --------------------------------------------------------------
# A local or CI Postgres. NEVER the Supabase project.
# TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres
